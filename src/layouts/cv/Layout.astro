---
import "@/styles/global.css";
import { getLangFromUrl, getAlternateUrls } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const alternates = getAlternateUrls(Astro.url, Astro.site!);
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="alternate" hreflang="en" href={alternates.en} />
		<link rel="alternate" hreflang="es" href={alternates.es} />
		<link rel="alternate" hreflang="x-default" href={alternates.en} />
		<title>Edwar | Portfolio</title>
	</head>
	<body class="bg-white dark:bg-slate-950 transition-colors duration-300">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
