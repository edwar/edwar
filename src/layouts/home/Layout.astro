---
import "@/styles/global.css";
import Background from "@/components/ui/Background.astro";
import { getLangFromUrl } from "@/i18n/utils";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { 
	title = "Edwar Amaya | Senior Frontend Developer & UI Designer", 
	description = "Frontend Developer specialized in high-performance web applications with React, Next.js, and Astro. Building beautiful, fast, and accessible digital experiences.",
	image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

const lang = getLangFromUrl(Astro.url);
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="description" content={description} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
		
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
	</head>
	<body class="bg-slate-950 text-white transition-colors duration-300">
		<script is:inline>
			const getInitialTheme = () => {
				const savedTheme = localStorage.getItem('theme');
				if (savedTheme) return savedTheme;
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const theme = getInitialTheme();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
				document.documentElement.classList.remove('light');
			} else {
				document.documentElement.classList.add('light');
				document.documentElement.classList.remove('dark');
			}
		</script>
		<Background>
			<slot />
		</Background>

		<script>
			import { gsap } from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";

			gsap.registerPlugin(ScrollTrigger);

			const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			if (!prefersReducedMotion) {
				// ─── HERO ENTRANCE ───────────────────────────────────
				const heroTl = gsap.timeline({ defaults: { ease: "power4.out" } });

				// Set initial states
				gsap.set("[data-hero-line]", { yPercent: 110, opacity: 0 });
				gsap.set("[data-hero-sub]", { y: 30, opacity: 0 });
				gsap.set("[data-hero-bio]", { y: 25, opacity: 0 });
				gsap.set("[data-hero-btn]", { y: 20, opacity: 0, scale: 0.95 });
				gsap.set("[data-hero-img]", { scale: 0.85, opacity: 0, filter: "blur(10px)" });
				gsap.set("[data-hero-badge]", { y: -15, opacity: 0 });
				gsap.set("[data-hero-nav]", { y: -20, opacity: 0 });

				// Animate
				heroTl
					.to("[data-hero-nav]", { y: 0, opacity: 1, duration: 0.5 }, 0)
					.to("[data-hero-badge]", { y: 0, opacity: 1, duration: 0.5 }, 0.15)
					.to("[data-hero-line]", { yPercent: 0, opacity: 1, duration: 0.9, stagger: 0.1 }, 0.2)
					.to("[data-hero-sub]", { y: 0, opacity: 1, duration: 0.6 }, 0.6)
					.to("[data-hero-bio]", { y: 0, opacity: 1, duration: 0.6 }, 0.75)
					.to("[data-hero-btn]", { y: 0, opacity: 1, scale: 1, duration: 0.5 }, 0.9)
					.to("[data-hero-img]", { scale: 1, opacity: 1, filter: "blur(0px)", duration: 1.2, ease: "power2.out" }, 0.3);

				// ─── NAVBAR SCROLL SHRINK ────────────────────────────
				ScrollTrigger.create({
					trigger: "body",
					start: "top top",
					end: "100px top",
				 onUpdate: (self) => {
						const progress = self.progress;
						const nav = document.querySelector("nav") as HTMLElement;
						if (!nav) return;
						nav.style.paddingBlock = `${8 - progress * 4}px`;
						nav.style.borderBottomColor = `rgba(255,255,255,${0.05 + progress * 0.05})`;
					},
				});

				// ─── SCROLL REVEALS ──────────────────────────────────
				// Slide up from bottom
				gsap.utils.toArray<HTMLElement>("[data-gsap='reveal']").forEach((el) => {
					gsap.fromTo(el,
						{ y: 60, opacity: 0 },
						{
							y: 0, opacity: 1, duration: 0.9, ease: "power3.out",
							scrollTrigger: { trigger: el, start: "top 93%", toggleActions: "play none none none" },
						}
					);
				});

				// 3D rotate-in for cards
				gsap.utils.toArray<HTMLElement>("[data-gsap='card']").forEach((el, i) => {
					gsap.fromTo(el,
						{
							y: 80,
							opacity: 0,
							rotateX: 8,
							rotateY: i % 2 === 0 ? -3 : 3,
							scale: 0.92,
							transformPerspective: 800,
						},
						{
							y: 0, opacity: 1, rotateX: 0, rotateY: 0, scale: 1,
							duration: 0.8,
							ease: "power3.out",
							scrollTrigger: { trigger: el, start: "top 94%", toggleActions: "play none none none" },
						}
					);
				});

				// Elastic pop-in for skill items
				gsap.utils.toArray<HTMLElement>("[data-gsap='pop']").forEach((el) => {
					gsap.fromTo(el,
						{ scale: 0, opacity: 0, rotation: -10 },
						{
							scale: 1, opacity: 1, rotation: 0,
							duration: 0.6, ease: "back.out(1.7)",
							scrollTrigger: { trigger: el, start: "top 92%", toggleActions: "play none none none" },
						}
					);
				});

				// Slide from left
				gsap.utils.toArray<HTMLElement>("[data-gsap='slide-left']").forEach((el) => {
					gsap.fromTo(el,
						{ x: -60, opacity: 0 },
						{
							x: 0, opacity: 1, duration: 0.8, ease: "power3.out",
							scrollTrigger: { trigger: el, start: "top 93%", toggleActions: "play none none none" },
						}
					);
				});

				// Slide from right
				gsap.utils.toArray<HTMLElement>("[data-gsap='slide-right']").forEach((el) => {
					gsap.fromTo(el,
						{ x: 60, opacity: 0 },
						{
							x: 0, opacity: 1, duration: 0.8, ease: "power3.out",
							scrollTrigger: { trigger: el, start: "top 93%", toggleActions: "play none none none" },
						}
					);
				});

				// Clip-path text reveal
				gsap.utils.toArray<HTMLElement>("[data-gsap='clip']").forEach((el) => {
					gsap.fromTo(el,
						{ clipPath: "inset(0 0 100% 0)", y: 20 },
						{
							clipPath: "inset(0 0 0% 0)", y: 0,
							duration: 0.8, ease: "power3.inOut",
							scrollTrigger: { trigger: el, start: "top 90%", toggleActions: "play none none none" },
						}
					);
				});

				// Scale-in
				gsap.utils.toArray<HTMLElement>("[data-gsap='scale']").forEach((el) => {
					gsap.fromTo(el,
						{ scale: 0.85, opacity: 0, y: 20 },
						{
							scale: 1, opacity: 1, y: 0, duration: 0.9, ease: "power3.out",
							scrollTrigger: { trigger: el, start: "top 93%", toggleActions: "play none none none" },
						}
					);
				});

				// ─── PARALLAX ────────────────────────────────────────
				gsap.utils.toArray<HTMLElement>("[data-gsap='parallax']").forEach((el) => {
					const speed = parseFloat(el.dataset.speed || "0.3");
					gsap.to(el, {
						y: () => -100 * speed,
						scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: 1.5 },
					});
				});

				// ─── 3D TILT ON HOVER ────────────────────────────────
				document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
					card.addEventListener("mousemove", (e) => {
						const rect = card.getBoundingClientRect();
						const x = e.clientX - rect.left;
						const y = e.clientY - rect.top;
						const centerX = rect.width / 2;
						const centerY = rect.height / 2;
						const rotateX = ((y - centerY) / centerY) * -5;
						const rotateY = ((x - centerX) / centerX) * 5;

						gsap.to(card, {
							rotateX, rotateY,
							transformPerspective: 800,
							duration: 0.4,
							ease: "power2.out",
						});
					});

					card.addEventListener("mouseleave", () => {
						gsap.to(card, {
							rotateX: 0, rotateY: 0,
							duration: 0.6,
							ease: "elastic.out(1, 0.5)",
						});
					});
				});

				// ─── MAGNETIC EFFECT ON BUTTONS ───────────────────────
				document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((btn) => {
					btn.addEventListener("mousemove", (e) => {
						const rect = btn.getBoundingClientRect();
						const x = e.clientX - rect.left - rect.width / 2;
						const y = e.clientY - rect.top - rect.height / 2;
						gsap.to(btn, { x: x * 0.3, y: y * 0.3, duration: 0.3, ease: "power2.out" });
					});
					btn.addEventListener("mouseleave", () => {
						gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: "elastic.out(1, 0.4)" });
					});
				});
			}

			// ─── SAFETY FALLBACK ────────────────────────────────────
			setTimeout(() => {
				document.querySelectorAll("[data-gsap], [data-hero-line], [data-hero-sub], [data-hero-bio], [data-hero-btn], [data-hero-img], [data-hero-badge], [data-hero-nav]").forEach((el) => {
					(el as HTMLElement).style.opacity = "1";
					(el as HTMLElement).style.transform = "none";
					(el as HTMLElement).style.clipPath = "none";
					(el as HTMLElement).style.filter = "none";
				});
			}, 4000);
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	/* Ensure cards don't clip 3D transforms */
	[data-tilt] {
		transform-style: preserve-3d;
		will-change: transform;
	}
</style>
