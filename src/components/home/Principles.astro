---
import Section from "@/components/ui/Section.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [1, 2, 3] as const;
---

<div class="border-y border-line bg-surface">
  <Section class="grid divide-y divide-line md:grid-cols-3 md:divide-x md:divide-y-0">
    {
      items.map((n) => (
        <div class="py-8 md:px-8 md:first:pl-0 md:last:pr-0" data-reveal>
          <h2 class="font-display text-xl font-semibold text-ink">{t(`principles.${n}.title` as const)}</h2>
          <p class="mt-2 text-ink-muted">{t(`principles.${n}.text` as const)}</p>
        </div>
      ))
    }
  </Section>
</div>
