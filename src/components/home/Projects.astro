---
import Section from "@/components/ui/Section.astro";
import BentoGrid from "@/components/ui/BentoGrid.astro";
import BentoGridItem from "@/components/ui/BentoGridItem.astro";
import { Icon } from "astro-icon/components";
import { projects } from "@/data/projects";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Bento layout: varied spans for visual rhythm
const spanClasses = [
  "", "", "",           // Row 1: Saludtools, Pichincha, ClubMiles
  "md:col-span-2", "", // Row 2: VLink(featured), Hermes
  "", "md:col-span-2", // Row 3: Loki, Apolo(featured)
  "", "", "",           // Row 4: Perseus, Thor, Atenea
  "md:col-span-2", "", // Row 5: Nabu(featured), CogniLab
];
---

<Section
  id="projects"
  class="flex flex-col w-full gap-5 items-center justify-center pt-24 scroll-mt-20"
>
  <h2 class="text-4xl font-bold flex items-center justify-center gap-2" data-gsap="clip">
    <span
      class="bg-clip-text text-transparent bg-gradient-to-r from-fuchsia-500 to-pink-500"
    >
      {t("projects.title")}
    </span>
    <Icon name="mdi:fire" class="text-fuchsia-600 animate-pulse shrink-0" />
  </h2>
  <BentoGrid class="p-5">
    {
      projects.map((item, index) => (
        <BentoGridItem
          key={index}
          image={item.image}
          icons={item.icons}
          title={item.name}
          description={t(item.descriptionKey)}
          link={item.link}
          linkLabel={t("projects.view")}
          class={spanClasses[index] || ""}
          data-gsap="card"
          data-tilt
        />
      ))
    }
  </BentoGrid>
</Section>
