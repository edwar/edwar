---
import Section from "@/components/ui/Section.astro";
import ProjectCard from "@/components/ui/ProjectCard.astro";
import ProjectRow from "@/components/ui/ProjectRow.astro";
import { projects, categories, FEATURED_COUNT } from "@/data/projects";
import { iconLabel } from "@/lib/utils";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featured = projects.slice(0, FEATURED_COUNT);
const rest = projects.slice(FEATURED_COUNT);
const linkLabel = t("projects.view");
const kindLabel = (kind: "company" | "own") => t(`work.kind.${kind}` as const);

const categoryCounts = categories.map((c) => [c, projects.filter((p) => p.categories.includes(c)).length] as const);

// Technology chips: meaningful technologies used by at least two projects
const generic = new Set(["html-5", "css-3", "javascript", "github-icon", "vercel-icon", "atlassian", "bitbucket", "stylus", "neon-icon", "firebase-icon"]);
const counts = new Map<string, number>();
projects.forEach((p) =>
  p.icons.forEach((icon) => {
    if (!generic.has(icon.split(":")[1])) counts.set(icon, (counts.get(icon) ?? 0) + 1);
  }),
);
const techFilters = [...counts.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);

const chip =
  "inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-medium text-ink transition-colors hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-accent-ink cursor-pointer";
const dataAttrs = (p: (typeof projects)[number]) => ({
  "data-project": "",
  "data-icons": p.icons.join(" "),
  "data-categories": p.categories.join(" "),
});
---

<Section id="projects" class="scroll-mt-20 pb-16 pt-16 md:pb-24 md:pt-24" data-projects>
  <h2 class="text-[clamp(1.75rem,4vw,2.5rem)] font-semibold leading-tight tracking-tight" data-reveal>
    {t("work.title")}
  </h2>

  <div class="mt-6 grid gap-4" data-reveal>
    <div role="group" aria-label={`${t("work.filter")}: ${t("work.category")}`} class="flex flex-wrap items-center gap-2">
      <span class="w-full text-sm font-medium text-ink-muted sm:w-28">{t("work.category")}</span>
      <button type="button" class={chip} data-filter="all" data-filter-type="category" aria-pressed="true">
        {t("work.all")} <span class="opacity-70">{projects.length}</span>
      </button>
      {
        categoryCounts.map(([c, n]) => (
          <button type="button" class={chip} data-filter={c} data-filter-type="category" aria-pressed="false">
            {t(`work.cat.${c}` as const)} <span class="opacity-70">{n}</span>
          </button>
        ))
      }
    </div>
    <div role="group" aria-label={`${t("work.filter")}: ${t("work.technology")}`} class="flex flex-wrap items-center gap-2">
      <span class="w-full text-sm font-medium text-ink-muted sm:w-28">{t("work.technology")}</span>
      <button type="button" class={chip} data-filter="all" data-filter-type="tech" aria-pressed="true">
        {t("work.all")}
      </button>
      {
        techFilters.map(([icon, n]) => (
          <button type="button" class={chip} data-filter={icon} data-filter-type="tech" aria-pressed="false">
            {iconLabel(icon)} <span class="opacity-70">{n}</span>
          </button>
        ))
      }
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-filter-status></p>

  <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-featured>
    {featured.map((p) => (
      <div {...dataAttrs(p)}>
        <ProjectCard {...p} description={t(p.descriptionKey)} linkLabel={linkLabel} kindLabel={kindLabel(p.kind)} />
      </div>
    ))}
  </div>

  <div class="mt-5 grid gap-4 lg:grid-cols-2" data-rest>
    {rest.map((p) => (
      <div {...dataAttrs(p)}>
        <ProjectRow {...p} description={t(p.descriptionKey)} linkLabel={linkLabel} kindLabel={kindLabel(p.kind)} />
      </div>
    ))}
  </div>

  <div class="mt-8 hidden rounded-xl border border-dashed border-line p-8 text-center" data-empty>
    <p class="text-ink-muted">{t("work.empty")}</p>
    <button type="button" class={`${chip} mt-4`} data-reset>{t("work.reset")}</button>
  </div>
</Section>

<script is:inline define:vars={{ countLabel: t("work.count") }}>
  (() => {
    const root = document.querySelector("[data-projects]");
    if (!root) return;
    const buttons = [...root.querySelectorAll("[data-filter]")];
    const items = [...root.querySelectorAll("[data-project]")];
    const status = root.querySelector("[data-filter-status]");
    const empty = root.querySelector("[data-empty]");
    const state = { category: "all", tech: "all" };

    const apply = () => {
      buttons.forEach((b) => {
        const type = b.dataset.filterType === "tech" ? "tech" : "category";
        b.setAttribute("aria-pressed", String(b.dataset.filter === state[type]));
      });
      let shown = 0;
      items.forEach((el) => {
        const okCat = state.category === "all" || el.dataset.categories.split(" ").includes(state.category);
        const okTech = state.tech === "all" || el.dataset.icons.split(" ").includes(state.tech);
        el.hidden = !(okCat && okTech);
        if (!el.hidden) shown++;
      });
      empty.classList.toggle("hidden", shown > 0);
      if (status) status.textContent = `${shown} ${countLabel}`;
      window.dispatchEvent(new Event("portfolio:layout"));
    };

    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        state[b.dataset.filterType === "tech" ? "tech" : "category"] = b.dataset.filter;
        apply();
      })
    );
    root.querySelector("[data-reset]")?.addEventListener("click", () => {
      state.category = "all";
      state.tech = "all";
      apply();
    });
  })();
</script>
