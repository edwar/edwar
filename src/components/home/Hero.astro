---
import { Image } from "astro:assets";
import edwar from "@/assets/edwar.webp";
import { Icon } from "astro-icon/components";
import Section from "@/components/ui/Section.astro";
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const whatsappText = encodeURIComponent(t('hero.whatsapp_msg'));
---

<Section class="relative z-20 w-full h-[50rem] flex items-center justify-center gap-10 lg:flex-row flex-col-reverse">
    <div class="flex flex-col items-center justify-center gap-5">
      <div class="overflow-hidden" data-hero-badge>
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-fuchsia-500/10 border border-fuchsia-500/20 text-sm font-medium text-fuchsia-600 dark:text-fuchsia-400">
          <Icon name="mdi:code-tags" width="16" height="16" />
          {lang === 'es' ? 'Desarrollador Frontend' : 'Frontend Developer'}
        </span>
      </div>

      <h1 class="font-extrabold lg:text-8xl text-7xl text-center text-slate-900 dark:text-white leading-[0.95]">
        <span class="block overflow-hidden"><span class="block" data-hero-line>{t('hero.greeting')}</span></span>
      </h1>

      <div class="overflow-hidden">
        <p class="lg:text-4xl text-2xl font-extralight text-center text-fuchsia-600 dark:text-fuchsia-400" data-hero-sub>{t('hero.title')}</p>
      </div>
      
      <div class="overflow-hidden">
        <p class="max-w-2xl text-center text-slate-600 dark:text-gray-400 mt-2 mb-4 text-lg" data-hero-bio>
          {lang === 'es' ? 'Apasionado por crear experiencias web hermosas y altamente funcionales utilizando las mejores tecnologías modernas.' : 'Passionate about building beautiful and highly functional web experiences using the best modern technologies.'}
        </p>
      </div>

      <div data-hero-btn>
        <a
          href={`https://wa.me/573175227672?text=${whatsappText}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t('hero.contact')}
          class="relative inline-flex items-center justify-center p-0.5 mb-2 me-2 overflow-hidden text-sm font-medium text-gray-900 dark:text-white rounded-lg group bg-gradient-to-br from-fuchsia-500 to-pink-500 hover:text-white focus:ring-4 focus:outline-none focus:ring-fuchsia-300 dark:focus:ring-fuchsia-800 transition-colors duration-300 cursor-pointer"
          data-magnetic
        >
          <div
            class="relative flex items-center justify-center gap-2 px-5 py-2.5 transition-all ease-in duration-75 bg-white dark:bg-gray-900 rounded-md group-hover:bg-transparent"
          >
            <Icon name="logos:whatsapp-icon" width="18" height="18" />
            {t('hero.contact')}
          </div>
        </a>
      </div>

    </div>
    <Image
      src={edwar}
      alt="Edwar Amaya"
      class="mask-b-from-80% mask-b-to-100% drop-shadow-lg drop-shadow-fuchsia-600 aspect-auto lg:aspect-[9/14] h-[50%] lg:h-[35rem] w-[20rem] lg:w-[25rem]"
      data-hero-img
    />
</Section>
