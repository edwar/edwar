---
/*
 * THESIS: a developer portfolio played straight at the best-in-class standard; the name itself is the craft demonstration.
 * OWN-WORLD: neutral scale tinted toward the photo green, one forest-green accent, Bricolage Grotesque display over Hanken Grotesk body, flat tonal surfaces with hairlines.
 * STORY: a visitor sees who Edwar is, that he builds complete products, and how to reach him, within one viewport.
 * FIRST VIEWPORT: left 7 columns hold role line, the name at 6rem in variable type reacting to the pointer, one value sentence, email (primary) and WhatsApp (secondary); right 5 columns hold the photo on an accent-soft panel.
 * FORM: category standard (canon), chosen by the user; no seed key (canon exit).
 */
import { Image } from "astro:assets";
import edwar from "@/assets/edwar.webp";
import { Icon } from "astro-icon/components";
import Section from "@/components/ui/Section.astro";
import { projects } from "@/data/projects";
import { site } from "@/data/site";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const whatsappText = encodeURIComponent(t("hero.whatsapp_msg"));
const nameWords = ["Edwar", "Amaya"];
---

<Section class="pt-10 pb-16 md:pt-16 md:pb-24">
  <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <p class="text-lg font-medium text-ink-muted" data-hero>{t("hero.badge")}</p>

      <h1
        class="mt-3 font-display text-[clamp(3.25rem,11vw,6rem)] font-bold leading-[0.95] tracking-[-0.03em] text-ink"
        data-name
      >
        <span class="sr-only">{nameWords.join(" ")}</span>
        {
          nameWords.map((word) => (
            <span class="block whitespace-nowrap" aria-hidden="true">
              {[...word].map((letter) => (
                <span class="inline-block" data-letter>
                  {letter}
                </span>
              ))}
            </span>
          ))
        }
      </h1>

      <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-ink-muted" data-hero>
        {t("hero.bio")}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3" data-hero>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-3 font-semibold text-accent-ink transition-opacity hover:opacity-90"
        >
          <Icon name="mdi:email-outline" width="20" height="20" aria-hidden="true" />
          {t("hero.email")}
        </a>
        <a
          href={`https://wa.me/573175227672?text=${whatsappText}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-5 py-3 font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="logos:whatsapp-icon" width="20" height="20" aria-hidden="true" />
          {t("hero.contact")}
        </a>
      </div>

      <p class="mt-8 text-base text-ink-muted" data-hero>
        <span class="font-semibold text-ink">{projects.length}</span>{" "}{t("hero.proof")} · React, Next.js, Astro, TypeScript
      </p>
    </div>

    <div class="lg:col-span-5">
      <div class="mx-auto aspect-[4/5] w-full max-w-sm overflow-hidden rounded-[20px] bg-accent-soft lg:max-w-none">
        <Image
          src={edwar}
          alt="Edwar Amaya"
          priority
          class="h-full w-full object-contain object-bottom"
        />
      </div>
    </div>
  </div>
</Section>
