---
import { getLangFromUrl, getAlternateUrls, useTranslations } from "@/i18n/utils";
import { site } from "@/data/site";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
	title = t("meta.title"),
	description = t("meta.description"),
	image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const alternates = getAlternateUrls(Astro.url, Astro.site!);

const person = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: site.name,
	jobTitle: t("hero.badge"),
	url: new URL("/", Astro.site).href,
	email: `mailto:${site.email}`,
	sameAs: [site.github, site.linkedin],
};
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="en" href={alternates.en} />
<link rel="alternate" hreflang="es" href={alternates.es} />
<link rel="alternate" hreflang="x-default" href={alternates.en} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={t("meta.locale")} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<script type="application/ld+json" set:html={JSON.stringify(person)} />
