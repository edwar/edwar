---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ProjectStack from "@/components/ui/ProjectStack.astro";

const { name, image, icons, description, link, linkLabel } = Astro.props;
---

<article
  class="group relative flex h-full gap-4 rounded-xl border border-line bg-surface p-3 transition-colors focus-within:border-accent hover:border-accent sm:gap-5 sm:p-4"
  data-reveal
>
  <div class="h-24 w-28 shrink-0 overflow-hidden rounded-lg bg-surface-2 sm:h-28 sm:w-36">
    <Image
      src={image}
      alt=""
      width={288}
      height={224}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-left-top transition-transform duration-500 motion-safe:group-hover:scale-[1.04]"
    />
  </div>
  <div class="flex min-w-0 flex-1 flex-col gap-1.5">
    <h3 class="flex items-center gap-1 text-lg font-semibold leading-tight text-ink">
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="decoration-accent decoration-2 underline-offset-4 after:absolute after:inset-0 group-hover:underline focus-visible:outline-offset-[-3px]"
      >
        {name}<span class="sr-only"> - {linkLabel}</span>
      </a>
      <Icon name="mdi:arrow-top-right" width="18" height="18" class="text-accent" aria-hidden="true" />
    </h3>
    <p class="text-sm text-ink-muted sm:text-base">{description}</p>
    <ProjectStack icons={icons.slice(0, 5)} class="mt-auto hidden sm:flex" />
  </div>
</article>
