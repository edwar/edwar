---
import { Icon } from "astro-icon/components";
import { iconLabel } from "@/lib/utils";

const { icons, class: className = "" } = Astro.props as { icons: string[]; class?: string };
---

<ul class={`flex flex-wrap gap-1.5 ${className}`}>
  {
    icons.map((icon) => (
      <li class="inline-flex items-center gap-1.5 rounded-lg bg-surface-2 px-2 py-1 text-xs font-medium text-ink-muted">
        <Icon name={icon} width="14" height="14" aria-hidden="true" />
        {iconLabel(icon)}
      </li>
    ))
  }
</ul>
