---
import { cn } from "@/lib/utils";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
const { class: className, image, icons, title, description, link, ...rest } = Astro.props;
---
<div
  class={cn(
    "group/bento flex flex-col rounded-2xl border border-slate-200/60 dark:border-white/10 bg-white/70 dark:bg-slate-800/50 backdrop-blur-sm shadow-none transition-all duration-500 hover:shadow-xl hover:shadow-fuchsia-500/5 hover:border-fuchsia-500/20 dark:hover:border-fuchsia-500/20 overflow-hidden",
    className,
  )}
  {...rest}
>
  {image && (
    <div class="relative h-48 overflow-hidden">
      <Image 
        src={image} 
        alt={title} 
        width={900} 
        height={600} 
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 scale-100 group-hover/bento:scale-105" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover/bento:opacity-100 transition-opacity duration-500" />
    </div>
  )}
  
  <div class="flex flex-col flex-1 p-5 min-h-0">
    <div class="flex flex-wrap gap-1.5 mb-3">
      {Array.isArray(icons) && icons.map((icon: string) => (
        <div class="flex items-center justify-center w-7 h-7 rounded-md bg-white/80 dark:bg-white/80 backdrop-blur-sm border border-slate-200/50 dark:border-transparent">
          <Icon name={icon} width="18" height="18" class="text-white" />
        </div>
      ))}
    </div>
    
    <h3 class="mb-1.5 text-lg font-bold text-slate-900 dark:text-white leading-tight">
      {title}
    </h3>
    
    <p class="text-sm text-slate-500 dark:text-gray-400 leading-relaxed line-clamp-2">
      {description}
    </p>
    
    <div class="mt-auto pt-3">
      <a href={link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-medium text-fuchsia-600 dark:text-fuchsia-400 hover:text-fuchsia-700 dark:hover:text-fuchsia-300 transition-colors group/link">
        <span class="group-hover/link:underline">View Project</span>
        <Icon name="mdi:arrow-right" width="16" height="16" class="transition-transform duration-300 group-hover/link:translate-x-0.5" />
      </a>
    </div>
  </div>
</div>
